
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema DTE</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="nuevo-diseno">

    <div class="aplicacion-dte">

        <!-- ENCABEZADO PRINCIPAL -->
        <header class="encabezado-dte">

            <div class="encabezado-informacion">
                <div class="logo-dte">DTE</div>

                <div>
                    <strong>Sistema DTE</strong>
                    <small>IPC2 - Proyecto 3</small>
                </div>
            </div>

            <!-- INICIO CENTRADO -->
            <a asp-page="/Index"
               class="boton-inicio">
                Inicio
            </a>

            <div class="encabezado-universidad">
                USAC
            </div>

        </header>

        <!-- NAVEGACION PRINCIPAL -->
        <nav class="navegacion-dte">

            <a asp-page="/EnviarMensaje"
               class="nav-boton">
                Enviar mensaje
            </a>

            <a asp-page="/ConsultarContribuyente"
               class="nav-boton">
                Consultar contribuyente
            </a>

            <a asp-page="/ResumenIva"
               class="nav-boton">
                Resumen IVA
            </a>

            <a asp-page="/ResumenRango"
               class="nav-boton">
                Resumen por fechas
            </a>

            <a asp-page="/Graficas"
               class="nav-boton">
                Graficas
            </a>

        </nav>

        <!-- CONTENIDO DE CADA PAGINA -->
        <main class="contenido-dte">
            @RenderBody()
        </main>

        <!-- ACCIONES INFERIORES -->
        <footer class="acciones-inferiores">

            <a asp-page="/Ayuda"
               class="boton-ayuda">
                Ayuda
            </a>

            <span class="texto-footer">
                Universidad de San Carlos de Guatemala
            </span>

            <a asp-page="/Inicializar"
               class="boton-inicializar">
                Inicializar
            </a>

        </footer>

    </div>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>
